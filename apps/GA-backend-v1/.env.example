# Copy to .env and fill your own values. Local .env files are ignored by Git.
HOST=127.0.0.1
PORT=8038
DATABASE_URL=mysql+pymysql://ga_user:your-password@127.0.0.1:3306/ai_service?charset=utf8mb4
SSO_URL=LOCAL_NO_AUTHZ
LLM_API_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=your-model-name
KB_CHAT_BASE_URL=http://127.0.0.1:7861
DEEPAGENT_SKILLS_PATH=../../assets/skills
# Docker deployment: set the host-side absolute directory used for sandbox mounts.
HOST_SKILLS_PATH=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional custom configuration file:
# GA_CONFIG_FILE=/absolute/path/to/config.local.yaml
