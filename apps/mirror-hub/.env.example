# MirrorHub 环境变量
#
# 由 scripts/start.sh 在首次启动时自动生成，并把占位符替换为随机强密钥。
# 也可手动 cp .env.example .env 后逐项填写。
#
# 注意：MIRRORHUB_ENV=production 下，缺失或过弱的凭据会导致后端拒绝启动。
# 下面所有以 change-me- 开头的值都必须替换（start.sh 会自动处理凭据项）。

# ---------------------------------------------------------------- 网络
# 内网主机 IP（客户端访问地址，也用于 verdaccio tarball 地址改写）
SERVER_IP=change-me-server-ip
NGINX_PORT=80
DEVPI_PORT=3141
VERDACCIO_PORT=4873

# ---------------------------------------------------------------- 凭据（必填，需为强随机值）
SECRET_KEY=change-me-secret-key
ADMIN_TOKENS=change-me-admin-token
DEVPI_PASSWORD=change-me-devpi-password
VERDACCIO_PASSWORD=change-me-verdaccio-password
POSTGRES_PASSWORD=change-me-postgres-password

# ---------------------------------------------------------------- 数据库
POSTGRES_USER=mirrorhub
POSTGRES_DB=mirrorhub

# ---------------------------------------------------------------- 镜像源凭据（用户名一般无需修改）
DEVPI_USER=root
VERDACCIO_USER=root

# ---------------------------------------------------------------- 认证（可选）
# local：用 ADMIN_TOKENS 登录；oidc：走企业 SSO 授权码流程
AUTH_MODE=local
# AUTH_MODE=oidc 时必填
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=*