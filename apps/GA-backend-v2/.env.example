# 复制为 .env 后按环境修改。环境变量优先级高于 config/config.yaml。
# 加载顺序：仓库根 .env -> 当前工作目录 .env

# ---------- 数据库 ----------
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/ai_service?charset=utf8mb4

# ---------- JWT ----------
# 生产环境必须显式注入；为空时进程启动会生成一次性随机密钥（重启后已签发 token 全部失效）
JWT_SECRET_KEY=please-change-me
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600

# ---------- 认证模式 ----------
# 本地账号登录模式固定为 LOCAL_NO_AUTHZ。
# V2 尚未迁移远程 SSO/CAS 令牌校验，配置成其它值会让受保护接口直接返回 501。
SSO_URL=LOCAL_NO_AUTHZ

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8038
LOG_LEVEL=INFO

# ---------- dsh 实例映射（供前置代理调用） ----------
# 前置代理用请求头 X-Internal-Token 携带该密钥调用 GET /internal/dsh/route。
# 留空 = 内部接口不启用（返回 503）。生产环境请换成强随机值，并与代理侧的
# DSH_BACKEND_TOKEN 保持一致；该接口只应让代理所在主机/内网可达。
DSH_INTERNAL_SECRET=please-change-me-too