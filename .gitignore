*.db-wal
*.sqlite
*.sqlite3
agent_memory/
chat_record_files/
screenshots/
.pytest_cache/
coverage/

# 部署者自己的配置；公共示例仍保留
config.local.yaml
config.local.yml
runtime-config.local.json

# 前端导入的第三方运行时产物需要随源码保留
!apps/GA-frontend-v1/src/vendors/**/dist/
!apps/GA-frontend-v1/src/vendors/**/dist/**
*.map

