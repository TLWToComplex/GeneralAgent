# Local render service (private deployment target for @antv/mcp-server-chart)
VIS_REQUEST_SERVER=http://127.0.0.1:8999/render-chart
COMPATIBILITY_MODE=true

# Render API service
RENDER_PORT=8999

# MCP Streamable HTTP service
MCP_HOST=0.0.0.0
MCP_PORT=1122
MCP_ENDPOINT=/mcp

# Optional: feature controls from @antv/mcp-server-chart
SERVICE_ID=
DISABLED_TOOLS=
