{
  "version": "1.0",
  "meta": {
    "name": "默认公文格式规范",
    "description": "适用于正式公文、报告、方案文档的标准格式",
    "author": ""
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margin_top_cm": 3.7,
    "margin_bottom_cm": 3.5,
    "margin_left_cm": 2.8,
    "margin_right_cm": 2.6,
    "footer_distance_cm": 2.5
  },
  "fonts": {
    "_comment": "中西文字体独立配置，运行时自动组合为 w:rFonts eastAsia/ascii/hAnsi",
    "cover_title":      { "cjk": "方正小标宋简体", "latin": "Times New Roman" },
    "cover_subtitle":   { "cjk": "楷体_GB2312",   "latin": "Times New Roman" },
    "cover_info":       { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "body":             { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "h1":               { "cjk": "黑体",           "latin": "Times New Roman" },
    "h2":               { "cjk": "楷体_GB2312",   "latin": "Times New Roman" },
    "h3":               { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "h4":               { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "toc_title":        { "cjk": "黑体",           "latin": "Times New Roman" },
    "toc_body":         { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "revision_title":   { "cjk": "黑体",           "latin": "Times New Roman" },
    "revision_header":  { "cjk": "黑体",           "latin": "Times New Roman" },
    "revision_body":    { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "header":           { "cjk": "仿宋_GB2312",   "latin": "Times New Roman" },
    "page_number":      { "cjk": "宋体",           "latin": "Times New Roman" },
    "table_caption":    { "cjk": "黑体",           "latin": "Times New Roman" },
    "figure_caption":   { "cjk": "黑体",           "latin": "Times New Roman" }
  },
  "sizes": {
    "cover_title_pt": 22,
    "cover_subtitle_pt": 16,
    "cover_info_pt": 14,
    "body_pt": 16,
    "table_body_pt": 14,
    "header_pt": 12,
    "h1_pt": 16,
    "h2_pt": 16,
    "h3_pt": 16,
    "h4_pt": 16,
    "toc_title_pt": 16,
    "toc_body_pt": 14,
    "revision_title_pt": 16,
    "revision_header_pt": 14,
    "revision_body_pt": 16,
    "page_number_pt": 14,
    "table_caption_pt": 14,
    "figure_caption_pt": 14
  },
  "spacing": {
    "body_line_spacing_pt": 28,
    "title_line_spacing_pt": 33,
    "first_line_indent_chars": 2,
    "heading_indent_chars": 0,
    "list_indent_level1_cm": 0,
    "list_indent_level2_cm": 0.74,
    "paragraph_before_pt": 0,
    "paragraph_after_pt": 0
  },
  "alignment": {
    "cover_title": "center",
    "cover_subtitle": "center",
    "cover_info": "center",
    "body": "both",
    "toc_title": "center",
    "revision_title": "center",
    "revision_header": "center",
    "revision_body": "left",
    "page_number": "奇偶分页"
  },
  "special_sections": {
    "revision_history": {
      "enabled": true,
      "detection_keywords": ["修订记录", "版本历史", "修订历史", "Revision History", "变更记录"],
      "table_columns": ["版本号", "修订日期", "修订内容", "修订人", "审核人"],
      "column_widths_cm": [2.0, 2.5, 8.0, 2.0, 2.0],
      "header_bold": true,
      "header_shading": "D9E2F3",
      "border_style": "single",
      "row_height_cm": 0.8
    },
    "toc": {
      "enabled": true,
      "detection_keywords": ["目录", "目  录", "Table of Contents"],
      "auto_generate": false
    },
    "cover": {
      "enabled": true,
      "detection_by": "first_section_titlePg",
      "max_pages": 2
    }
  },
  "validation": {
    "strict_mode": true,
    "max_retries": 5,
    "checks": [
      "page_margins",
      "page_size",
      "cover_fonts",
      "body_fonts",
      "heading_fonts",
      "revision_section",
      "toc_section",
      "line_spacing",
      "paragraph_alignment",
      "first_line_indent",
      "page_numbers",
      "table_borders",
      "table_header_fonts",
      "table_body_fonts",
      "list_indent",
      "heading_indent",
      "figure_caption",
      "table_caption"
    ]
  }
}
